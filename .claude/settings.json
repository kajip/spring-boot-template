{
  "permissions": {
    "deny": [
      "Edit(/doc/autogen/**)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-check.sh",
            "timeout": 600,
            "statusMessage": "Running ./gradlew check..."
          }
        ]
      }
    ]
  }
}
