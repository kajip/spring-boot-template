{
  "permissions": {
    "deny": [
      "Edit(/doc/autogen/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-check.sh",
            "timeout": 600,
            "statusMessage": "Running ./gradlew check..."
          }
        ]
      }
    ]
  }
}
